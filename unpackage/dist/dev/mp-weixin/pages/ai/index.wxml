<view class="container data-v-2e7a9c24"><view class="title animate-fadein data-v-2e7a9c24">AI 图片风格转换</view><block wx:if="{{!uploadedImageUrl}}"><view data-event-opts="{{[['tap',[['chooseImage',['$event']]]]]}}" class="{{['uploadArea','animate-card','data-v-2e7a9c24',(pageReady)?'card-show':'']}}" style="{{'animation-delay:'+('0.15s')+';'}}" bindtap="__e"><view class="{{['uploadIcon','animate-bouncein','data-v-2e7a9c24',(pageReady)?'show':'']}}" style="{{'animation-delay:'+('0.4s')+';'}}">+</view><view class="uploadText data-v-2e7a9c24">点击上传图片</view><view class="uploadHint data-v-2e7a9c24">支持 JPG、PNG 格式，最大 4MB</view></view></block><block wx:if="{{uploadedImageUrl}}"><view class="{{['card-box','animate-card','data-v-2e7a9c24',(cardShow)?'card-show':'']}}" style="{{'animation-delay:'+('0.1s')+';'}}"><view class="section-header data-v-2e7a9c24"><view class="section-label data-v-2e7a9c24">原图</view><view data-event-opts="{{[['tap',[['chooseImage',['$event']]]]]}}" class="action-btn data-v-2e7a9c24" catchtap="__e">重新上传</view></view><image class="previewImg data-v-2e7a9c24" src="{{uploadedImageUrl}}" mode="aspectFit"></image><block wx:if="{{imageSize}}"><view class="imageInfo data-v-2e7a9c24">{{imageSize}}</view></block></view></block><block wx:if="{{$root.g0}}"><view class="{{['card-box','animate-card','data-v-2e7a9c24',(cardShow)?'card-show':'']}}" style="{{'animation-delay:'+('0.2s')+';'}}"><view class="section-label data-v-2e7a9c24">选择风格</view><view data-event-opts="{{[['tap',[['openStylePopup',['$event']]]]]}}" class="currentStyle data-v-2e7a9c24" bindtap="__e"><image class="currentStyleImg data-v-2e7a9c24" src="{{styleOptions[selectedStyle].image}}" mode="aspectFill"></image><view class="currentStyleInfo data-v-2e7a9c24"><view class="currentStyleName data-v-2e7a9c24">{{styleOptions[selectedStyle].name}}</view><view class="currentStyleHint data-v-2e7a9c24">点击切换风格</view></view><view class="currentStyleArrow data-v-2e7a9c24"><text class="data-v-2e7a9c24">›</text></view></view></view></block><style-select-popup vue-id="be4d2d3c-1" style-options="{{styleOptions}}" selected-index="{{selectedStyle}}" data-ref="stylePopup" data-event-opts="{{[['^select',[['onStyleSelect']]]]}}" bind:select="__e" class="data-v-2e7a9c24 vue-ref" bind:__l="__l"></style-select-popup><block wx:if="{{uploadedImageUrl}}"><view class="{{['card-box','animate-card','data-v-2e7a9c24',(cardShow)?'card-show':'']}}" style="{{'animation-delay:'+('0.3s')+';'}}"><view class="section-label data-v-2e7a9c24">自定义描述（可选）</view><textarea class="promptInput data-v-2e7a9c24" placeholder="输入你想要的风格描述，留空将使用选择的风格" maxlength="{{200}}" auto-height="{{true}}" data-event-opts="{{[['input',[['__set_model',['','promptText','$event',[]]]]]]}}" value="{{promptText}}" bindinput="__e"></textarea><view class="promptCount data-v-2e7a9c24">{{$root.g1+"/200"}}</view></view></block><view class="{{['btnGroup','animate-card','data-v-2e7a9c24',(uploadedImageUrl?cardShow:pageReady)?'card-show':'']}}" style="{{'animation-delay:'+(uploadedImageUrl?'0.4s':'0.25s')+';'}}"><block wx:if="{{uploadedImageUrl}}"><view class="energyInfo data-v-2e7a9c24"><text class="energyLabel data-v-2e7a9c24">剩余能量：</text><text class="{{['energyValue','data-v-2e7a9c24',(energy<energyCost)?'low':'']}}">{{energy}}</text><text class="energyCost data-v-2e7a9c24">{{'/ 本次消耗 '+energyCost}}</text></view></block><view class="{{['btnBox','data-v-2e7a9c24',(isLoading)?'loading':'',(!uploadedImageUrl||energy<energyCost)?'disabled':'']}}" hover-class="hover" data-event-opts="{{[['tap',[['generateImage',['$event']]]]]}}" bindtap="__e"><block wx:if="{{isLoading}}"><view class="btn-loading data-v-2e7a9c24"><block wx:for="{{3}}" wx:for-item="n" wx:for-index="__i0__" wx:key="*this"><view class="btn-dot data-v-2e7a9c24" style="{{'animation-delay:'+(n*0.15+'s')+';'}}"></view></block></view></block><block wx:else><text class="data-v-2e7a9c24">一键生成</text></block></view></view><block wx:if="{{isLoading}}"><view class="loadingBox animate-card card-show data-v-2e7a9c24"><view class="loadingAnim data-v-2e7a9c24"><block wx:for="{{3}}" wx:for-item="n" wx:for-index="__i1__" wx:key="*this"><view class="dot data-v-2e7a9c24" style="{{'animation-delay:'+(n*0.2+'s')+';'}}"></view></block></view><view class="loadingText data-v-2e7a9c24">{{loadingText}}</view></view></block><block wx:if="{{resultImageUrl}}"><view class="{{['card-box','resultCard','animate-card','data-v-2e7a9c24',(resultShow)?'card-show':'']}}"><view class="section-header data-v-2e7a9c24"><view class="section-label data-v-2e7a9c24">AI 生成结果</view><view data-event-opts="{{[['tap',[['saveImage',['$event']]]]]}}" class="action-btn data-v-2e7a9c24" catchtap="__e">保存到相册</view></view><image class="resultImg data-v-2e7a9c24" src="{{resultImageUrl}}" mode="widthFix"></image><view class="saveHint data-v-2e7a9c24">长按图片也可保存到相册</view></view></block></view>