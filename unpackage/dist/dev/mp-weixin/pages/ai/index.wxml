<view class="container data-v-2e7a9c24"><view class="title data-v-2e7a9c24">AI 图片风格转换</view><block wx:if="{{!uploadedImageUrl}}"><view data-event-opts="{{[['tap',[['chooseImage',['$event']]]]]}}" class="uploadArea data-v-2e7a9c24" bindtap="__e"><view class="uploadIcon data-v-2e7a9c24">+</view><view class="uploadText data-v-2e7a9c24">点击上传图片</view><view class="uploadHint data-v-2e7a9c24">支持 JPG、PNG 格式，最大 4MB</view></view></block><block wx:if="{{uploadedImageUrl}}"><view class="previewBox data-v-2e7a9c24"><view class="previewHeader data-v-2e7a9c24"><view class="previewLabel data-v-2e7a9c24">原图</view><view data-event-opts="{{[['tap',[['chooseImage',['$event']]]]]}}" class="reuploadBtn data-v-2e7a9c24" catchtap="__e">重新上传</view></view><image class="previewImg data-v-2e7a9c24" src="{{uploadedImageUrl}}" mode="aspectFit"></image><block wx:if="{{imageSize}}"><view class="imageInfo data-v-2e7a9c24">{{imageSize}}</view></block></view></block><block wx:if="{{uploadedImageUrl}}"><view class="styleBox data-v-2e7a9c24"><view class="styleLabel data-v-2e7a9c24">选择风格</view><view class="styleList data-v-2e7a9c24"><block wx:for="{{styleOptions}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" data-event-params="{{({index})}}" class="{{['styleItem','data-v-2e7a9c24',(selectedStyle===index)?'active':'']}}" bindtap="__e">{{''+item.name+''}}</view></block></view></view></block><block wx:if="{{uploadedImageUrl}}"><view class="promptBox data-v-2e7a9c24"><view class="promptLabel data-v-2e7a9c24">自定义描述（可选）</view><textarea class="promptInput data-v-2e7a9c24" placeholder="输入你想要的风格描述，留空将使用选择的风格" maxlength="{{200}}" auto-height="{{true}}" data-event-opts="{{[['input',[['__set_model',['','promptText','$event',[]]]]]]}}" value="{{promptText}}" bindinput="__e"></textarea><view class="promptCount data-v-2e7a9c24">{{$root.g0+"/200"}}</view></view></block><view class="btnGroup data-v-2e7a9c24"><view class="{{['btnBox','data-v-2e7a9c24',(isLoading)?'loading':'',(!uploadedImageUrl)?'disabled':'']}}" hover-class="hover" data-event-opts="{{[['tap',[['generateImage',['$event']]]]]}}" bindtap="__e">{{''+(isLoading?"AI 处理中...":"开始 AI 创作")+''}}</view></view><block wx:if="{{isLoading}}"><view class="loadingBox data-v-2e7a9c24"><view class="loadingAnim data-v-2e7a9c24"><block wx:for="{{3}}" wx:for-item="n" wx:for-index="__i0__" wx:key="*this"><view class="dot data-v-2e7a9c24" style="{{'animation-delay:'+(n*0.2+'s')+';'}}"></view></block></view><view class="loadingText data-v-2e7a9c24">{{loadingText}}</view></view></block><block wx:if="{{resultImageUrl}}"><view class="resultBox data-v-2e7a9c24"><view class="resultHeader data-v-2e7a9c24"><view class="previewLabel data-v-2e7a9c24">AI 生成结果</view><view data-event-opts="{{[['tap',[['saveImage',['$event']]]]]}}" class="saveBtn data-v-2e7a9c24" catchtap="__e">保存到相册</view></view><image class="resultImg data-v-2e7a9c24" src="{{resultImageUrl}}" mode="widthFix"></image><view class="saveHint data-v-2e7a9c24">长按图片也可保存到相册</view></view></block></view>