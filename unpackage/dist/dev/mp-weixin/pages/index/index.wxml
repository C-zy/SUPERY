<view class="container data-v-57280228"><view class="login-section data-v-57280228"><block wx:if="{{userInfo}}"><view class="user-info data-v-57280228"><image class="avatar data-v-57280228" src="{{userInfo.avatar_url}}" mode="aspectFill"></image><view class="user-name data-v-57280228">{{userInfo.nickname}}</view><view data-event-opts="{{[['tap',[['handleLogout',['$event']]]]]}}" class="logout-btn data-v-57280228" bindtap="__e">退出登录</view></view></block><block wx:else><view data-event-opts="{{[['tap',[['handleLogin',['$event']]]]]}}" class="login-btn data-v-57280228" bindtap="__e"><view class="btn-text data-v-57280228">{{isLoading?'登录中...':'微信一键登录'}}</view></view></block></view><block wx:if="{{userInfo}}"><view data-event-opts="{{[['tap',[['handleUseAi',['$event']]]]]}}" class="use-ai-btn data-v-57280228" bindtap="__e">使用AI</view></block></view>